# Copy to .env and adjust. Never commit .env (NFR-07).
#   cp .env.example .env

# ---- runtime mode (FR-34)
APP_ENV=development
DEMO_READ_ONLY=false

# ---- database (local dev: the Postgres container from docker-compose)
POSTGRES_USER=loglens
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=loglens
DATABASE_URL=postgresql+psycopg://loglens:change-me-locally@localhost:5432/loglens

# ---- API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_SIZE_MB=5
MAX_LOG_LINES=20000
UPLOAD_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO

# ---- SSH parser: classic syslog lines have no year/timezone.
# 0 = current UTC year. Use an IANA name for the timezone, e.g. Asia/Singapore.
SSH_LOG_YEAR=0
SSH_LOG_TIMEZONE=UTC

# ---- docker compose host ports (change if something on your Mac already uses them)
DB_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=8080

# Load the synthetic samples automatically when the backend container starts.
SEED_SAMPLES=false
